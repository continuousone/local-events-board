<section id="rsvp" class="container mx-auto px-6 py-8">
  <div class="form-wrap">
    <h1>RSVP: {{event.title}}</h1>
    <p class="mb-4">{{event.event_date}} &mdash; {{event.location}}</p>

    {{#each errors}}
      <div class="error">
        <p>{{text}}</p>
      </div>
    {{/each}}

    <form action="/events/{{event.id}}/rsvp" method="POST">
      <div class="input-group">
        <label for="name">Your Name</label>
        <input type="text" name="name" id="name" class="input-box" value={{name}}>
      </div>
      <div class="input-group">
        <label for="email">Your Email</label>
        <input type="email" name="email" id="email" class="input-box" value={{email}}>
      </div>
      <div class="input-group">
        <label for="status">Status</label>
        <select name="status" id="status" class="input-box">
          <option value="going">Going</option>
          <option value="interested">Interested</option>
        </select>
      </div>
      <input type="submit" value="RSVP" class="btn btn-reverse">
    </form>
  </div>

  <div class="form-wrap mt-6">
    <h2 class="text-xl font-bold mb-3">Who's coming ({{attendees.length}})</h2>
    {{#each attendees}}
      <p class="text-sm mb-1">{{this.name}} &mdash; <span class="text-gray-400">{{this.status}}</span></p>
    {{else}}
      <p class="text-sm text-gray-400">No RSVPs yet &mdash; be the first!</p>
    {{/each}}
  </div>
</section>