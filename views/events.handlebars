<section id="events" class="container mx-auto px-6 py-8">
    <h1 class="text-3xl font-bold mb-6">All Events</h1>

    <div class="flex flex-wrap gap-6">
      {{#each events}}
        <div class="w-64 h-72 bg-gray-900 text-white rounded-lg shadow-lg overflow-hidden flex flex-col justify-between">
          {{#if image}}
            <img src="/uploads/{{image}}" alt="{{title}}" class="w-full h-28 object-cover">
          {{/if}}
          <div class="p-5 flex flex-col justify-between flex-1">
          <div>
            <h3 class="text-lg font-bold mb-2 truncate">{{title}}</h3>
            <p class="text-sm text-gray-300 line-clamp-3">{{description}}</p>
          </div>
          <div>
            <p class="text-sm mb-1">Date: {{event_date}}</p>
            <p class="text-sm mb-1">Location: {{location}}</p>
            <p class="text-xs text-gray-400 mb-3">Category: {{category}}</p>
            <a href="mailto:{{contact_email}}" class="inline-block bg-blue-500 hover:bg-blue-600 text-white text-sm px-3 py-1 rounded">Contact Organizer</a>
          </div>
          </div>
        </div>
      {{else}}
        <p>No events available</p>
      {{/each}}
    </div>
  </section>
